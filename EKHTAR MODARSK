<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>منصة تقييم المعلمين</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, sans-serif; }
  body { background: #f0f4f8; color: #222; }
  header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: #fff; text-align: center; padding: 40px 20px; }
  header h1 { font-size: 2rem; margin-bottom: 8px; }
  header p { opacity: .9; }
  .container { max-width: 1000px; margin: 30px auto; padding: 0 15px; }
  .search-box { display: flex; gap: 10px; margin-bottom: 25px; }
  .search-box input, .search-box select { padding: 10px; border: 1px solid #ccc; border-radius: 8px; font-size: 1rem; }
  .search-box input { flex: 1; }
  .teachers { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .card { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 2px 8px rgba(0,0,0,.08); text-align: center; }
  .card img { width: 90px; height: 90px; border-radius: 50%; object-fit: cover; margin-bottom: 10px; }
  .card h3 { margin-bottom: 4px; }
  .subject { color: #3b82f6; font-size: .9rem; margin-bottom: 8px; }
  .avg { font-size: 1.1rem; font-weight: bold; color: #f59e0b; margin: 8px 0; }
  .stars { font-size: 1.6rem; cursor: pointer; user-select: none; }
  .stars span { color: #ccc; transition: color .15s; }
  .stars span.active, .stars span:hover { color: #f59e0b; }
  .count { font-size: .8rem; color: #777; margin-top: 6px; }
  .thanks { color: green; font-size: .85rem; height: 18px; margin-top: 4px; }
</style>
</head>
<body>

<header>
  <h1>⭐ منصة تقييم المعلمين</h1>
  <p>اختر معلمك وقيّم تجربتك معه</p>
</header>

<div class="container">
  <div class="search-box">
    <input type="text" id="search" placeholder="🔍 ابحث عن معلم...">
    <select id="filter">
      <option value="">كل المواد</option>
      <option>رياضيات</option>
      <option>فيزياء</option>
      <option>لغة عربية</option>
      <option>إنجليزية</option>
      <option>كيمياء</option>
    </select>
  </div>

  <div class="teachers" id="list"></div>
</div>

<script>
// البيانات (في مشروع حقيقي تأتي من قاعدة بيانات)
let teachers = JSON.parse(localStorage.getItem('teachers')) || [
  { id:1, name:'أ. أحمد الشمري', subject:'رياضيات', img:'https://i.pravatar.cc/150?img=12', ratings:[] },
  { id:2, name:'أ. سارة العتيبي', subject:'فيزياء',   img:'https://i.pravatar.cc/150?img=47', ratings:[] },
  { id:3, name:'أ. محمد القحطاني', subject:'لغة عربية', img:'https://i.pravatar.cc/150?img=33', ratings:[] },
  { id:4, name:'أ. نورة الدوسري', subject:'إنجليزية', img:'https://i.pravatar.cc/150?img=45', ratings:[] },
  { id:5, name:'أ. خالد المطيري', subject:'كيمياء',   img:'https://i.pravatar.cc/150?img=51', ratings:[] },
  { id:6, name:'أ. ريم الحربي',  subject:'رياضيات',  img:'https://i.pravatar.cc/150?img=32', ratings:[] },
];

function save() { localStorage.setItem('teachers', JSON.stringify(teachers)); }

function avg(t){ return t.ratings.length ? (t.ratings.reduce((a,b)=>a+b,0)/t.ratings.length) : 0; }

function render() {
  const q = document.getElementById('search').value.trim();
  const f = document.getElementById('filter').value;
  const list = document.getElementById('list');
  list.innerHTML = '';

  teachers
    .filter(t => t.name.includes(q) && (!f || t.subject === f))
    .forEach(t => {
      const a = avg(t);
      let starsHtml = '';
      for (let i = 1; i <= 5; i++)
        starsHtml += `<span data-id="${t.id}" data-v="${i}" class="${i <= Math.round(a) ? 'active' : ''}">★</span>`;

      list.innerHTML += `
        <div class="card">
          <img src="${t.img}" alt="${t.name}">
          <h3>${t.name}</h3>
          <div class="subject">${t.subject}</div>
          <div class="avg">التقييم: ${a ? a.toFixed(1) : '—'} / 5</div>
          <div class="stars" title="اضغط للتقييم">${starsHtml}</div>
          <div class="count">${t.ratings.length ? `عدد المقيّمين: ${t.ratings.length}` : 'لم يُقيَّم بعد'}</div>
          <div class="thanks" id="msg-${t.id}"></div>
        </div>`;
    });
}

// التقييم بالنقر على النجوم
document.getElementById('list').addEventListener('click', e => {
  if (e.target.tagName === 'SPAN') {
    const id = +e.target.dataset.id, v = +e.target.dataset.v;
    const t = teachers.find(x => x.id === id);
    t.ratings.push(v);
    save();
    render();
    const msg = document.getElementById('msg-' + id);
    if (msg) { msg.textContent = '✅ شكراً لتقييمك!'; setTimeout(() => msg.textContent = '', 2000); }
  }
});

document.getElementById('search').addEventListener('input', render);
document.getElementById('filter').addEventListener('change', render);

render();
</script>
</body>
</html>
